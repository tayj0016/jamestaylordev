<section id="contact" class="py-24 px-6 max-w-2xl mx-auto border-t border-neutral-800">
    <p class="text-neutral-500 text-sm tracking-widest uppercase mb-4">
        Contact
    </p>

    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Let's work together.
    </h2>

    <p class="text-neutral-400 mb-10">
        Have a project in mind? Fill out the form below and I'll get back to you within 24 hours.
    </p>

    <form
            id="contact-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="flex flex-col gap-4"
    >
        <input
                type="hidden"
                name="access_key"
                value="ee3b75e2-f075-4d76-a833-4d6b69961aa6"
        />

        <input
                type="hidden"
                name="subject"
                value="New project inquiry from jamestaylor.dev"
        />

        <!-- Web3Forms honeypot -->
        <input
                type="checkbox"
                name="botcheck"
                class="hidden"
                style="display: none;"
        />

        <input
                type="text"
                name="name"
                placeholder="Your name"
                required
                class="bg-neutral-900 border border-neutral-800 rounded-lg px-4 py-3 text-white placeholder-neutral-600 focus:outline-none focus:border-neutral-500 transition-colors"
        />

        <input
                type="email"
                name="email"
                placeholder="Your email"
                required
                class="bg-neutral-900 border border-neutral-800 rounded-lg px-4 py-3 text-white placeholder-neutral-600 focus:outline-none focus:border-neutral-500 transition-colors"
        />

        <textarea
                name="message"
                placeholder="Tell me about your project"
                rows="5"
                required
                class="bg-neutral-900 border border-neutral-800 rounded-lg px-4 py-3 text-white placeholder-neutral-600 focus:outline-none focus:border-neutral-500 transition-colors resize-none"
        ></textarea>

        <button
                id="contact-submit"
                type="submit"
                class="px-6 py-3 bg-white text-neutral-950 font-medium rounded-lg hover:bg-neutral-200 transition-colors text-sm w-fit disabled:opacity-50 disabled:cursor-not-allowed"
        >
            Send message
        </button>
    </form>

    <div
            id="contact-success"
            class="hidden border border-neutral-800 rounded-xl p-6 text-center"
    >
        <div class="text-white text-lg font-semibold mb-2">
            Message sent!
        </div>

        <p class="text-neutral-400 text-sm">
            Thanks for reaching out. I will get back to you within 24 hours.
        </p>
    </div>

    <div
            id="contact-error"
            class="hidden mt-4 text-red-400 text-sm"
            role="alert"
    >
        Something went wrong. Please try again.
    </div>
</section>

<script>
    import '../scripts/contact';
</script>
---
import ServiceCard from './ServiceCard.astro';
import {services} from '../data/services';
---

<section id="services" class="py-24 px-6 max-w-4xl mx-auto border-t border-neutral-800">
    <p class="text-neutral-500 text-sm tracking-widest uppercase mb-4">Services</p>

    <h2 class="text-3xl md:text-4xl font-bold text-white mb-12">
        What I do.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {services.map(service => (
                <ServiceCard {...service}/>
        ))}
    </div>
</section>
---
import ProjectCard from './ProjectCard.astro';
import Lightbox from './Lightbox.astro';
import {projects} from '../data/projects';
---

<section id="projects" class="py-24 px-6 max-w-4xl mx-auto border-t border-neutral-800">
    <p class="text-neutral-500 text-sm tracking-widest uppercase mb-4">
        Projects
    </p>

    <h2 class="text-3xl md:text-4xl font-bold text-white mb-12">
        Recent work.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
        {projects.map((project, index) => (
                <ProjectCard project={project} index={index}/>
        ))}
    </div>
</section>

<Lightbox/>